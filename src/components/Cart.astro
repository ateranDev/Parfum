<div class="relative inline-block text-left">
  <!-- Botón / Icono del carrito -->
  <button
    type="button"
    aria-label="Ver carrito"
    class="relative p-2 text-2xl transition-transform duration-150 hover:scale-110 focus:outline-none hover:cursor-pointer"
    id="btn-cart"
  >
    🛒
    <!-- Badge opcional para contar productos (ejemplo: 3) -->
    <span
      class="absolute top-0 right-0 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-red-500 rounded-full"
    >
    </span>
  </button>

  <!-- Menú desplegable del carrito -->
  <div
    id="cart"
    class="hidden absolute -right-25 md:right-0 mt-2 w-80 sm:w-96 rounded-xl bg-white p-4 shadow-xl ring-1 ring-black/5 z-50"
  >
    <h3
      class="text-base font-semibold text-gray-800 pb-3 border-b border-gray-100"
    >
      Tu Carrito
    </h3>

    <!-- Contenedor con scroll para los productos -->
    <div
      id="cart-list"
      class="max-h-72 overflow-y-auto divide-y divide-gray-100 my-2"
    >
    </div>

    <!-- Footer con Total y Botones de Acción -->
    <div class="pt-3 border-t border-gray-100 space-y-3">
      <div
        class="flex justify-between items-center text-sm font-semibold text-gray-900"
      >
        <span>Total:</span>
        <span id="cart-total" class="text-lg font-bold text-green-600"
          >$0.00</span
        >
      </div>

      <div class="grid grid-cols-2 gap-2">
        <button
          id="emptyCart"
          class="w-full py-2 px-3 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors hover:cursor-pointer"
        >
          Vaciar
        </button>
        <button
          class="w-full py-2 px-3 text-xs font-semibold text-white bg-green-600 hover:bg-green-700 rounded-lg transition-colors shadow-sm"
        >
          Pagar
        </button>
      </div>
    </div>
  </div>
</div>

<script src="../scripts/cart.ts"></script>
