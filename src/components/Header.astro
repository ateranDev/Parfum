---
import Cart from "./Cart.astro";

const navLinks = [{ href: "/colection", label: "Colección" }];

let firstMid: number | null = null;

try {
  const response = await fetch("https://api.cotizave.com/v1/fx/rates", {
    headers: {
      "X-API-Key": import.meta.env.SECRET_API_KEY_BCV,
      Accept: "application/json",
    },
  });
  if (response.ok) {
    const data = await response.json();
    firstMid = parseFloat(data.rates[0]?.mid) || null;
  }
} catch (error) {
  console.error("Error al obtener la tasa de cambio:", error);
}
---

<header
  class="fixed top-0 z-50 w-full bg-stone-50 flex flex-col md:flex-row duration-200 gap-4 py-5 md:py-6 px-6 md:px-16 justify-between items-center border-b-[.1em] border-b-gray-200"
>
  <a href="/" class="logo-mark" aria-label="AURA Parfum — Inicio">
    <span class="logo-word">J&M</span>
    <span class="logo-sub">Parfum</span>
  </a>

  <nav
    class="flex items-center gap-3 lg:gap-6 text-xs tracking-[0.2em] font-medium uppercase text-neutral-700"
  >
    {
      navLinks.map((link) => (
        <a href={link.href} class="nav-pill">
          {link.label}
        </a>
      ))
    }
  </nav>

  <div>
    <p class="text-sm text-[#666666]">
      Tasa de cambio
      <strong class="text-[#1a1a1a]"> {firstMid?.toFixed(2)} Bs</strong>
    </p>
  </div>

  <Cart />
</header>

<style>
  /* ---------- LOGO ---------- */
  .logo-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    text-decoration: none;
    position: relative;
    padding-bottom: 0.35rem;
  }

  .logo-word {
    font-family: "Cormorant Garamond", serif;
    font-weight: 700;
    font-size: clamp(1.7rem, 4.2vw, 2.5rem);
    letter-spacing: 0.16em;
    background: linear-gradient(120deg, #1a1a1a 0%, #1a1a1a 55%, #c5a059 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: letter-spacing 0.35s ease;
  }

  .logo-sub {
    font-family: "Montserrat", sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: #c5a059;
    margin-top: 0.15rem;
  }

  /* línea con diamante central, firma de marca */
  .logo-mark::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 34px;
    height: 6px;
    transform: translateX(-50%) rotate(45deg);
    background: transparent;
    border: 1px solid #c5a059;
    border-width: 0 0 1px 1px;
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .logo-mark:hover .logo-word {
    letter-spacing: 0.22em;
  }

  .logo-mark:hover::after {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .logo-sub {
      letter-spacing: 0.3em;
    }
  }

  /* ---------- NAV ---------- */
  .nav-pill {
    position: relative;
    padding: 0.7rem 1.25rem;
    font-size: 0.65rem;
    border: 1px solid #1a1a1a;
    border-radius: 999px;
    color: #1a1a1a;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .nav-pill:hover {
    background-color: #1a1a1a;
    color: #f5f0e8;
    border-color: #1a1a1a;
  }

  @media (min-width: 768px) {
    .nav-pill {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  const cart = document.querySelector("#cart");
  const btnCarrito = document.querySelector("#btn-cart");

  btnCarrito?.addEventListener("click", () => {
    cart?.classList.toggle("hidden");
  });
</script>
