---
import Cart from "./Cart.astro";

const navLinks = [
  { href: "/colection", label: "Colección" },
  { href: "/man", label: "Hombre" },
  { href: "/women", label: "Mujer" },
  { href: "/unisex", label: "Unisex" },
];

const response = await fetch("https://api.cotizave.com/v1/fx/rates", {
  headers: {
    "X-API-Key": import.meta.env.SECRET_API_KEY_BCV,
    Accept: "application/json",
  },
});
const data = await response.json();
const firstMid = data.rates[0]?.mid;
---

<header
  class="fixed top-0 z-50 w-full bg-stone-50 flex flex-col md:flex-row duration-200 gap-4 py-6 px-16 justify-between items-center border-b-[.1em] border-b-gray-200"
>
  <a class="text-gray-800 text-[2rem] tracking-[3px] font-bold logo" href="/"
    >AURA</a
  >

  <nav
    class="flex items-center gap-6 lg:gap-10 text-xs tracking-[0.2em] font-medium uppercase text-neutral-700"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="relative py-1 transition-colors hover:text-[#c5a059] after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-[#c5a059] hover:after:w-full after:transition-all after:duration-300 text-[10px] md:text-[14px]"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div>
    <p class="text-sm">
      Tasa de cambio <strong>{parseFloat(firstMid).toFixed(2)}</strong>
    </p>
  </div>
  <Cart />
</header>

<style>
  .logo {
    font-family: "Cormorant Garamond", serif;
  }
</style>

<script>
  const cart = document.querySelector("#cart");
  const btnCarrito = document.querySelector("#btn-cart");

  btnCarrito?.addEventListener("click", () => {
    // Remueve 'hidden' si la tiene, o la añade si no la tiene
    cart?.classList.toggle("hidden");
  });
</script>
