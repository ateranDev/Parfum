<Layout
  title="Colección Completa | J&M Parfum"
  description="Explora nuestra colección completa de fragancias exclusivas y de autor."
>
  <main class="px-6 py-24 md:px-12 md:py-20 mt-28 md:mt-26 max-w-7xl mx-auto">
    <!-- Header de la colección -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <span class="uppercase text-[#c5a059] tracking-[2px] font-bold text-xs">
        Catálogo Exclusivo
      </span>
      <h1
        class="uppercase text-4xl md:text-5xl font-medium mt-2 mb-4 title-serif text-[#1a1a1a]"
      >
        Nuestra Colección
      </h1>
      <p class="text-[#666666] text-sm md:text-base leading-relaxed">
        Descubre notas aromáticas únicas diseñadas para evocar memorias y
        emociones. Encuentra la fragancia que defina tu estilo personal.
      </p>
    </header>

    <!-- Grid de productos -->
    <section
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-12 grid_productos"
    >
      {
        products.map((product) => (
          <div class="flex flex-col items-center">
            <CardProduct
              title={product.title}
              src={product.src}
              alt={product.alt}
              price={product.price}
            />
            <span class="text-xs text-[#666666] mt-1 tracking-wider uppercase">
              {product.category}
            </span>
          </div>
        ))
      }
    </section>
  </main>
</Layout>

<style is:global>
  .title-serif {
    font-family: "Cormorant Garamond", serif;
  }
  @media (max-width: 400px) {
    .grid_productos {
      grid-template-columns: 1fr;
    }
  }
</style>
